# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (Supabase → Project Settings → API). Sem estas variáveis o app roda em modo local.
# A anon key é pública por design (vai para o navegador); a proteção dos dados vem do RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
